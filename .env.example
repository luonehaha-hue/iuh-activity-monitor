# ==========================================
# CẤU HÌNH TOOL BÁO SỰ KIỆN ĐIỂM RÈN LUYỆN IUH
# ==========================================

# 1. THÔNG TIN TELEGRAM
# Lấy BOT TOKEN từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=

# Lấy CHAT ID từ bot @userinfobot hoặc @myidbot trên Telegram
TELEGRAM_CHAT_ID=

# 2. COOKIE PHIÊN ĐĂNG NHẬP IUH
# Đăng nhập vào https://doantn.iuh.edu.vn trên trình duyệt
# F12 -> Application -> Cookies -> Copy giá trị PHPSESSID (hoặc nguyên chuỗi Cookie)
PHPSESSID=

# 3. CẤU HÌNH THỜI GIAN
# Tần suất kiểm tra (tính bằng GIÂY) - Mặc định 20 giây một lần
CHECK_INTERVAL_SECONDS=15

# Tần suất gửi báo cáo định kỳ (tính bằng PHÚT) - 120 phút = 2 tiếng báo 1 lần
STATUS_UPDATE_MINUTES=60

# Thời gian chờ giữa 2 lần báo lại cùng một sự kiện còn slot (tính bằng PHÚT)
NOTIFY_COOLDOWN_MINUTES=5


# 4. CẢNH BÁO ÂM THANH TRÊN MÁY TÍNH (Windows Beep)
# True = Bật chuông kêu tít tít khi có slot, False = Tắt
SOUND_ALERT=False

# Ghim cảnh báo trong nhóm Telegram (True/False)
PIN_ALERT_IN_GROUP=False

# Giữ lại để tương thích cấu hình hiện tại
TAG_ALL_IN_GROUP=True

# 6. DISCORD (để trống nếu không dùng)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# 5. LINK DONATE ỦNG HỘ BOT
DONATE_URL=
